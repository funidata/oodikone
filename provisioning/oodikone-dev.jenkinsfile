pipeline {
  agent { label 'docker' }

  options {
    ansiColor('xterm')
    timestamps()
  }

  environment {
    ANSIBLE_PLAYBOOK = "ansible-playbook --diff -i ${params.ANSIBLE_AWS_ENVIRONMENT}.aws_ec2.yml -l ${params.ANSIBLE_OODIKONE_HOSTS}"
    ANSIBLE_FORCE_COLOR = "true"
    ANSIBLE_LIMIT = "${params.ANSIBLE_LIMIT ? ${params.ANSIBLE_LIMIT} : "" }"

    // Ansible aws_ec2 inventory plugin settings
    AWS_EC2_PROFILE = "none" // use IAM account credentials from env

    // container for ansible-playbooks, build locally
    DOCKER_IMAGE_NAMESPACE = "${AWS_ECR_REGISTRY}/oodikone"
    DOCKER_IMAGE_TAG = "${env.BUILD_TAG}"
    DOCKER_IMAGE_NAME = "${env.DOCKER_IMAGE_NAMESPACE}/provisioning:${env.DOCKER_IMAGE_TAG}"

    DOCKER_AGENT_ARGS = "--net=host --name=jenkins-agent.${env.BUILD_TAG}.provisioning --read-only --tmpfs /tmp:exec"
  }

  stages {
    stage("Setup") {
      options {
        withCredentials([
          usernamePassword(
            credentialsId: params.GITHUB_CREDENTIALS,
            usernameVariable: 'GITHUB_USERNAME',
            passwordVariable: 'GITHUB_TOKEN',
          )
        ])
      }

      steps {
        dir('provisioning') {
          sh "env | sort"
          // build provisioning image using GITHUB_USERNAME env and GITHUB_TOKEN secret
          sh "./docker-compose.sh build provisioning"
        }
      }
    }

    stage("Deploy") {
      agent {
        docker {
          image "${env.DOCKER_IMAGE_NAME}"
          args "${env.DOCKER_AGENT_ARGS}"
          reuseNode true
        }
      }

      options {
        withCredentials([
          usernamePassword(
            credentialsId: params.AWS_CREDENTIALS,
            usernameVariable: 'AWS_ACCESS_KEY_ID',
            passwordVariable: 'AWS_SECRET_ACCESS_KEY',
          ),
          file(credentialsId: params.ANSIBLE_VAULT_CREDENTIALS, variable: 'ANSIBLE_VAULT_PASSWORD_FILE'),
        ])
      }

      steps {
        sshagent(credentials: [params.ANSIBLE_SSH_CREDENTIALS]) {
          dir('provisioning') {
            sh(script: "${env.ANSIBLE_PLAYBOOK} oodikone-stop.yml -l ${env.ANSIBLE_LIMIT}")
            sh(script: "${env.ANSIBLE_PLAYBOOK} aws-oodikone-install.yml -e oodikone_version=${params.VERSION} -l ${env.ANSIBLE_LIMIT}")
          }
        }
      }
    }
  }
}
