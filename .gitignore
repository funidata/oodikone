# See http://help.github.com/ignore-files/ for more about ignoring
# files.
#
# If you find yourself ignoring temp files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile ~/.gitignore

# Ignore all logfiles
*.log
*.log.*

# Ignore all tempfiles
/tmp
/provisioning/roles/logstash/files/selinux/logrotate-docker/tmp/

## Ignore all generated files
/.mimosa
/coverage
*.tmproj
*.sublime-workspace

# Output folder
/dist

# Numerous always-ignore extensions
*~
*.diff
*.err
*.orig
*.log
*.rej
*.swo
*.swp
*.vi
*~
*.sass-cache

# OS or Editor folders
.DS_Store
.cache
.project
.settings
.tmproj
.run
nbproject
Thumbs.db

# Idea metadata
.idea

# ansible generated temporary files
/provisioning/*.retry

# ignore python venv
venv/

# temporary Yarn files
.yarn-mutex

# angular filesystem cache
.angular

# VS Code settings
.vscode

# if using direnv
.envrc
